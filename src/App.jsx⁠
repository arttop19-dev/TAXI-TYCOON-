import React, { useState, useEffect } from 'react';
import { supabase } from './supabaseClient';
import SplashScreen from './components/SplashScreen';
import { Car, Trophy, User, Fuel, Wrench, PlayCircle } from 'lucide-react';

const CARS_DATA = [
  { id: 'vaz_2107', name: 'ВАЗ-2107', price: 0, class: 'Эконом', income: 400 },
  { id: 'solaris', name: 'Hyundai Solaris', price: 15000, class: 'Комфорт', income: 1200 },
  { id: 'camry', name: 'Toyota Camry', price: 50000, class: 'Бизнес', income: 3500 },
  { id: 'maybach', name: 'Mercedes-Maybach', price: 200000, class: 'VIP', income: 10000 },
];

export default function App() {
  const [isStarted, setIsStarted] = useState(false);
  const [activeTab, setActiveTab] = useState('orders'); // 'orders', 'garage', 'leaders', 'profile'
  const [user, setUser] = useState(null);
  const [activeCar, setActiveCar] = useState(CARS_DATA[0]);
  const [fuel, setFuel] = useState(100);
  const [condition, setCondition] = useState(100);
  const [isDriving, setIsDriving] = useState(false);
  const [leaderboard, setLeaderboard] = useState([]);
  const [promoInput, setPromoInput] = useState('');
  const [nicknameInput, setNicknameInput] = useState('');

  useEffect(() => {
    initUser();
  }, []);

  const initUser = async () => {
    const tgUser = window.Telegram?.WebApp?.initDataUnsafe?.user || {
      id: 80399910,
      first_name: 'Данил',
      photo_url: null
    };

    let { data: profile } = await supabase
      .from('profiles')
      .select('*')
      .eq('telegram_id', tgUser.id)
      .single();

    if (!profile) {
      const { data: newProfile } = await supabase
        .from('profiles')
        .insert({
          telegram_id: tgUser.id,
          first_name: tgUser.first_name,
          avatar_url: tgUser.photo_url,
          balance: 1500.00
        })
        .select()
        .single();
      profile = newProfile;
    }

    setUser(profile);
    setNicknameInput(profile?.custom_nickname || profile?.first_name || '');
    fetchLeaderboard();
  };

  const fetchLeaderboard = async () => {
    const { data } = await supabase.rpc('get_top_earners', { limit_count: 20 });
    if (data) setLeaderboard(data);
  };

  const handleCompleteOrder = async () => {
    if (fuel < 15 || condition < 10) {
      alert("Машине нужен ремонт или заправка!");
      return;
    }

    setIsDriving(true);
    setTimeout(async () => {
      const reward = activeCar.income;
      const newBalance = Number(user.balance) + reward;
      const newEarned = Number(user.total_earned) + reward;
      const newTrips = user.total_trips + 1;

      setFuel(prev => Math.max(0, prev - 15));
      setCondition(prev => Math.max(0, prev - 8));

      const { data: updated } = await supabase
        .from('profiles')
        .update({
          balance: newBalance,
          total_earned: newEarned,
          total_trips: newTrips
        })
        .eq('id', user.id)
        .select()
        .single();

      setUser(updated);
      setIsDriving(false);
      fetchLeaderboard();
    }, 2500);
  };

  const handleRefuel = async () => {
    if (user.balance < 300) return alert("Недостаточно денег ($300)!");
    const { data } = await supabase
      .from('profiles')
      .update({ balance: user.balance - 300 })
      .eq('id', user.id)
      .select().single();
    setUser(data);
    setFuel(100);
  };

  const handleRepair = async () => {
    if (user.balance < 500) return alert("Недостаточно денег ($500)!");
    const { data } = await supabase
      .from('profiles')
      .update({ balance: user.balance - 500 })
      .eq('id', user.id)
      .select().single();
    setUser(data);
    setCondition(100);
  };

  const handleBuyCar = (car) => {
    if (user.balance < car.price) return alert("Недостаточно средств!");
    setActiveCar(car);
    alert(`Вы перели на ${car.name}!`);
  };

  const handleApplyPromo = async () => {
    if (promoInput.toUpperCase() === 'START2026') {
      const { data } = await supabase
        .from('profiles')
        .update({ balance: Number(user.balance) + 5000 })
        .eq('id', user.id)
        .select().single();
      setUser(data);
      alert("Промокод активирован! +5000 $");
      setPromoInput('');
    } else {
      alert("Неверный промокод");
    }
  };

  const handleSaveNickname = async () => {
    const { data } = await supabase
      .from('profiles')
      .update({ custom_nickname: nicknameInput })
      .eq('id', user.id)
      .select().single();
    setUser(data);
    alert("Позывной сохранен!");
  };

  if (!isStarted) {
    return <SplashScreen userProfile={user} onStartGame={() => setIsStarted(true)} />;
  }

  return (
    <div className="flex flex-col h-screen bg-slate-950 text-slate-100 font-sans select-none">
      {/* Шапка: Баланс и Статус */}
      <div className="p-4 bg-slate-900 border-b border-slate-800 flex justify-between items-center">
        <div>
          <div className="text-xs text-slate-400">Баланс</div>
          <div className="text-xl font-black text-amber-400">${Number(user?.balance || 0).toLocaleString()}</div>
        </div>
        <div className="text-right">
          <div className="text-xs text-slate-400">Рейтинг</div>
          <div className="text-sm font-bold text-yellow-400">⭐ {user?.rating || "4.80"}</div>
        </div>
      </div>

      {/* Контент активного экрана */}
      <div className="flex-1 overflow-y-auto p-4 space-y-4">
        {activeTab === 'orders' && (
          <div className="space-y-4">
            {/* Статус авто */}
            <div className="bg-slate-900 border border-slate-800 rounded-2xl p-4 grid grid-cols-2 gap-4">
              <div className="space-y-1">
                <div className="flex justify-between text-xs text-slate-400">
                  <span className="flex items-center space-x-1"><Fuel className="w-3.5 h-3.5" /> <span>Бензин</span></span>
                  <span>{fuel}%</span>
                </div>
                <div className="h-2 bg-slate-800 rounded-full overflow-hidden">
                  <div className="h-full bg-amber-500" style={{ width: `${fuel}%` }} />
                </div>
                <button onClick={handleRefuel} className="w-full text-xs py-1 mt-1 bg-slate-800 hover:bg-slate-700 rounded-lg text-amber-400 font-bold">
                  Заправить ($300)
                </button>
              </div>

              <div className="space-y-1">
                <div className="flex justify-between text-xs text-slate-400">
                  <span className="flex items-center space-x-1"><Wrench className="w-3.5 h-3.5" /> <span>Состояние</span></span>
                  <span>{condition}%</span>
                </div>
                <div className="h-2 bg-slate-800 rounded-full overflow-hidden">
                  <div className="h-full bg-blue-500" style={{ width: `${condition}%` }} />
                </div>
                <button onClick={handleRepair} className="w-full text-xs py-1 mt-1 bg-slate-800 hover:bg-slate-700 rounded-lg text-blue-400 font-bold">
                  Починить ($500)
                </button>
              </div>
            </div>

            {/* Карточка текущего заказа */}
            <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 text-center space-y-4">
              <div className="text-xs font-bold text-amber-500 uppercase tracking-wider">{activeCar.class} КЛАСС</div>
              <h2 className="text-2xl font-black">{activeCar.name}</h2>
              <div className="text-3xl font-black text-green-400">+${activeCar.income}</div>

              <button
                disabled={isDriving}
                onClick={handleCompleteOrder}
                className="w-full py-4 bg-gradient-to-r from-amber-500 to-yellow-500 text-slate-950 font-black text-lg rounded-xl active:scale-95 transition-all shadow-[0_0_20px_rgba(245,158,11,0.3)] disabled:opacity-50"
              >
                {isDriving ? "В ПОЕЗДКЕ..." : "ВЗЯТЬ ЗАКАЗ"}
              </button>
            </div>
          </div>
        )}

        {activeTab === 'garage' && (
          <div className="space-y-3">
            <h2 className="text-lg font-bold">Гараж и Машины</h2>
            {CARS_DATA.map((car) => (
              <div key={car.id} className="bg-slate-900 border border-slate-800 p-4 rounded-xl flex justify-between items-center">
                <div>
                  <div className="font-bold">{car.name}</div>
                  <div className="text-xs text-slate-400">Доход: +${car.income} / рейс</div>
                </div>
                {activeCar.id === car.id ? (
                  <span className="text-xs font-bold text-amber-500 bg-amber-500/10 px-3 py-1.5 rounded-lg border border-amber-500/30">
                    Выбрано
                  </span>
                ) : (
                  <button
                    onClick={() => handleBuyCar(car)}
                    className="px-3 py-1.5 bg-amber-500 text-slate-950 font-bold text-xs rounded-lg"
                  >
                    ${car.price.toLocaleString()}
                  </button>
                )}
              </div>
            ))}
          </div>
        )}

        {activeTab === 'leaders' && (
          <div className="space-y-3">
            <h2 className="text-lg font-bold">Топ Магнатов Такси</h2>
            <div className="space-y-2">
              {leaderboard.map((item) => (
                <div key={item.rank} className="bg-slate-900 border border-slate-800 p-3 rounded-xl flex items-center justify-between">
                  <div className="flex items-center space-x-3">
                    <span className="font-mono text-sm font-bold w-6 text-amber-500">#{item.rank}</span>
                    <img src={item.avatar_url || "https://api.dicebear.com/7.x/bottts/svg?seed=Taxi"} className="w-8 h-8 rounded-lg object-cover" />
                    <div>
                      <div className="text-sm font-bold">{item.display_name}</div>
                      <div className="text-[10px] text-slate-400">Заказов: {item.total_trips}</div>
                    </div>
                  </div>
                  <div className="text-sm font-black text-amber-400">${Number(item.total_earned).toLocaleString()}</div>
                </div>
              ))}
            </div>
          </div>
        )}

        {activeTab === 'profile' && (
          <div className="space-y-4">
            <div className="bg-slate-900 border border-slate-800 p-4 rounded-xl space-y-3">
              <h3 className="text-sm font-bold text-slate-400">Позывной водителя</h3>
              <div className="flex space-x-2">
                <input
                  type="text"
                  value={nicknameInput}
                  onChange={(e) => setNicknameInput(e.target.value)}
                  className="bg-slate-800 border border-slate-700 px-3 py-2 rounded-lg text-sm flex-1"
                />
                <button onClick={handleSaveNickname} className="bg-amber-500 text-slate-950 font-bold text-xs px-3 rounded-lg">
                  Сохранить
                </button>
              </div>
            </div>

            <div className="bg-slate-900 border border-slate-800 p-4 rounded-xl space-y-3">
              <h3 className="text-sm font-bold text-slate-400">Промокод</h3>
              <div className="flex space-x-2">
                <input
                  type="text"
                  placeholder="START2026"
                  value={promoInput}
                  onChange={(e) => setPromoInput(e.target.value)}
                  className="bg-slate-800 border border-slate-700 px-3 py-2 rounded-lg text-sm flex-1"
                />
                <button onClick={handleApplyPromo} className="bg-amber-500 text-slate-950 font-bold text-xs px-3 rounded-lg">
                  Ввести
                </button>
              </div>
            </div>
          </div>
        )}
      </div>

      {/* Нижнее навигационное меню */}
      <div className="bg-slate-900 border-t border-slate-800 grid grid-cols-4 p-2 text-center text-xs">
        <button onClick={() => setActiveTab('orders')} className={`py-2 ${activeTab === 'orders' ? 'text-amber-500 font-bold' : 'text-slate-400'}`}>
          <PlayCircle className="w-5 h-5 mx-auto mb-1" />
          <span>Заказы</span>
        </button>
        <button onClick={() => setActiveTab('garage')} className={`py-2 ${activeTab === 'garage' ? 'text-amber-500 font-bold' : 'text-slate-400'}`}>
          <Car className="w-5 h-5 mx-auto mb-1" />
          <span>Гараж</span>
        </button>
        <button onClick={() => setActiveTab('leaders')} className={`py-2 ${activeTab === 'leaders' ? 'text-amber-500 font-bold' : 'text-slate-400'}`}>
          <Trophy className="w-5 h-5 mx-auto mb-1" />
          <span>Топ</span>
        </button>
        <button onClick={() => setActiveTab('profile')} className={`py-2 ${activeTab === 'profile' ? 'text-amber-500 font-bold' : 'text-slate-400'}`}>
          <User className="w-5 h-5 mx-auto mb-1" />
          <span>Профиль</span>
        </button>
      </div>
    </div>
  );
}
